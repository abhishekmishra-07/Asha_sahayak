# Copy this file to .env. Leave DATABASE_URL blank to use local SQLite.
# Keep real credentials private; .env is ignored by git.
GEMINI_API_KEY=
DATABASE_URL=
ASHA_HOST=127.0.0.1
ASHA_PORT=8765
# Only change ASHA_DATA_DIR if you want reports/local migration sources somewhere else.
# ASHA_DATA_DIR=C:\\Users\\YourName\\AppData\\Local\\AshaSahayak\\data
# Import existing records only after reviewing the source. Choose one:
# ASHA_IMPORT_SQLITE=1
# ASHA_IMPORT_JSON=1
